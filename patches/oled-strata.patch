@@ -0,0 +1,21 @@
+/*
+ * Strata portrait layout for SSD1306 128x32, rendered sideways by software.
+ *
+ * The stock ZMK widgets still supply the state; this module only draws it
+ * into a 32x128 L8 canvas and rotates that buffer into the 128x32 panel.
+ * No extra listeners, no custom status-screen override.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <lvgl.h>
+
+void strata_ui_create(lv_obj_t *screen);
+
+void strata_ui_set_output(const char *text, bool connected, int profile, bool bonded);
+void strata_ui_set_battery(uint8_t level, bool charging);
+void strata_ui_set_layer(int index, const char *label);
+void strata_ui_set_link(bool connected);
