From 608b52420f17676b20135f1666946ffd71fe823c Mon Sep 17 00:00:00 2001
From: sira313 <me@apoxi.cam>
Date: Mon, 23 Nov 2026 22:23:33 +0700
Subject: [PATCH] feat(display): strata portrait OLED layout for Corne (SSD1306
 128x32)

- 32x128 portrait canvas rotated 90deg into the 128x32 panel, software only
- left: output/BT profiles, 5 layer boxes, battery gauge with charging bolt
- right: pixel logo, split LINK status, battery gauge
- stock widgets kept as hidden state sources feeding the strata UI
---
 app/src/display/status_screen.c             | 343 +++++++++++++++++++-
 app/src/display/strata_ui.h                 |  21 ++
 app/src/display/widgets/battery_status.c    |  35 +--
 app/src/display/widgets/layer_status.c      |  19 +-
 app/src/display/widgets/output_status.c     |  38 ++-
 app/src/display/widgets/peripheral_status.c |   6 +-
 6 files changed, 394 insertions(+), 68 deletions(-)
 create mode 100644 app/src/display/strata_ui.h

diff --git a/app/src/display/status_screen.c b/app/src/display/status_screen.c
index 58de09ae..96a2a7c0 100644
--- a/app/src/display/status_screen.c
+++ b/app/src/display/status_screen.c
@@ -2,8 +2,19 @@
  * Copyright (c) 2020 The ZMK Contributors
  *
  * SPDX-License-Identifier: MIT
+ *
+ * Strata portrait layout. Content is drawn into a 32x128 L8 buffer (the same
+ * shape as the nice!view mockup) and copied rotated into a 128x32 L8 canvas
+ * that LVGL blits to the SSD1306.
+ *
+ * Central (left): output, Bluetooth profiles, layers and battery.
+ * Peripheral (right): pixel logo, split link status and battery.
  */
 
+#include <stdio.h>
+#include <string.h>
+
+#include <zmk/keymap.h>
 #include <zmk/display/widgets/output_status.h>
 #include <zmk/display/widgets/peripheral_status.h>
 #include <zmk/display/widgets/battery_status.h>
@@ -14,6 +25,318 @@
 #include <zephyr/logging/log.h>
 LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 
+#include "strata_ui.h"
+
+#define PVIEW_W 32
+#define PVIEW_H 128
+#define PANEL_W 128
+#define PANEL_H 32
+
+#define STRATA_BG lv_color_white()
+#define STRATA_FG lv_color_black()
+
+#define PSTRIDE 32
+#define DSTRIDE 128
+
+static uint8_t portrait_buf[PVIEW_W * PVIEW_H] __aligned(4);
+static uint8_t panel_buf[PANEL_W * PANEL_H] __aligned(4);
+
+static lv_obj_t *portrait_canvas;
+static lv_obj_t *panel_canvas;
+
+struct strata_state {
+    char output[12];
+    bool connected;
+    int profile;
+    uint8_t battery;
+    bool charging;
+    int layer_index;
+    char layer_label[12];
+    bool link;
+};
+
+static struct strata_state state = {
+    .profile = -1,
+};
+
+/* OLED logo: 32x64 (full width, height from aspect), centred between
+ * LINK and battery; inverted 1-bit (bright pixels drawn dark), no pre-rotation so
+ * the panel shows it 90deg CW. Bit 0 is the leftmost pixel of each row. */
+static const uint32_t strata_logo[64] __attribute__((unused)) = {
+    0x00000000, 0x00000000, 0x00000000, 0x00000000,
+    0x00000000, 0x19800000, 0x3fc000c0, 0x3fc001e0,
+    0x1f800040, 0x0f000000, 0x0600000c, 0x001ff80c,
+    0x007c1f00, 0x01e007c0, 0x078000e0, 0x0c000030,
+    0x18e03018, 0x31c0180c, 0x63801866, 0x67800826,
+    0xcf100c36, 0xdb310c13, 0x1a230413, 0x36630445,
+    0x6063066d, 0x60e306fd, 0x400326ff, 0xc2cb23ef,
+    0xc7e9a37d, 0x96e9b321, 0xb42c9101, 0xb19cd981,
+    0xb75fc181, 0xf75fa18d, 0x771feccc, 0x3b1fecc4,
+    0x6bffe166, 0x67ffe162, 0x477fff33, 0xc7e3ff11,
+    0xc7eed638, 0xb3effe70, 0xb1fefc62, 0xb0f1fb02,
+    0xf07ffe03, 0x723fc643, 0x32003641, 0x0601fcc1,
+    0x0613ec80, 0x0c73f8b8, 0x18e3d8fc, 0x39e7b1fe,
+    0x76ef33e3, 0xe66ea38c, 0xcdb5a73e, 0xc8d726ff,
+    0x984431c3, 0x13fbdb03, 0x33186601, 0x73366401,
+    0x63ebcc81, 0x61cd8b81, 0x61cd8700, 0x608c0600,
+};
+
+static void strata_fill(lv_layer_t *layer, int x, int y, int w, int h, lv_color_t color) {
+    lv_draw_rect_dsc_t dsc;
+    lv_draw_rect_dsc_init(&dsc);
+    dsc.bg_color = color;
+    dsc.bg_opa = LV_OPA_COVER;
+
+    lv_area_t area = {x, y, x + w - 1, y + h - 1};
+    lv_draw_rect(layer, &dsc, &area);
+}
+
+/* Borders on a 1-bit canvas render as solid blocks, so draw the outline as
+ * four thin filled strips instead. */
+static void strata_outline(lv_layer_t *layer, int x, int y, int w, int h) {
+    strata_fill(layer, x, y, w, 1, STRATA_FG);
+    strata_fill(layer, x, y + h - 1, w, 1, STRATA_FG);
+    strata_fill(layer, x, y, 1, h, STRATA_FG);
+    strata_fill(layer, x + w - 1, y, 1, h, STRATA_FG);
+}
+
+/* Filled rect with r corner pixels cut per side; r is clamped to fit. */
+static void strata_fill_rounded(lv_layer_t *layer, int x, int y, int w, int h, int r, lv_color_t color) {
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    if (r > w / 2) {
+        r = w / 2;
+    }
+    if (r > h / 2) {
+        r = h / 2;
+    }
+
+    for (int dy = 0; dy < h; dy++) {
+        int inset = 0;
+        if (dy < r) {
+            inset = r - dy;
+        } else if (dy >= h - r) {
+            inset = r - (h - 1 - dy);
+        }
+        strata_fill(layer, x + inset, y + dy, w - 2 * inset, 1, color);
+    }
+}
+
+/* 1-px rounded outline: shortened straight runs plus a corner staircase. */
+static void strata_outline_rounded(lv_layer_t *layer, int x, int y, int w, int h, int r) {
+    strata_fill(layer, x + r, y, w - 2 * r, 1, STRATA_FG);
+    strata_fill(layer, x + r, y + h - 1, w - 2 * r, 1, STRATA_FG);
+    strata_fill(layer, x, y + r, 1, h - 2 * r, STRATA_FG);
+    strata_fill(layer, x + w - 1, y + r, 1, h - 2 * r, STRATA_FG);
+
+    for (int i = 1; i < r; i++) {
+        strata_fill(layer, x + r - i, y + i, 1, 1, STRATA_FG);
+        strata_fill(layer, x + w - 1 - (r - i), y + i, 1, 1, STRATA_FG);
+        strata_fill(layer, x + r - i, y + h - 1 - i, 1, 1, STRATA_FG);
+        strata_fill(layer, x + w - 1 - (r - i), y + h - 1 - i, 1, 1, STRATA_FG);
+    }
+}
+
+/* Small lightning bolt (5x7) drawn inside the battery shell while charging. */
+static void strata_draw_bolt(lv_layer_t *layer, int x, int y, lv_color_t color) {
+    static const uint8_t bolt[7] = {0x03, 0x06, 0x0c, 0x1f, 0x06, 0x0c, 0x18};
+
+    for (int row = 0; row < 7; row++) {
+        for (int col = 0; col < 5; col++) {
+            if (bolt[row] & (1u << (4 - col))) {
+                strata_fill(layer, x + col, y + row, 1, 1, color);
+            }
+        }
+    }
+}
+
+static void strata_draw_text(lv_layer_t *layer, int x, int y, const char *text) {
+    if (text == NULL || text[0] == '\0') {
+        return;
+    }
+
+    lv_draw_label_dsc_t dsc;
+    lv_draw_label_dsc_init(&dsc);
+    dsc.color = STRATA_FG;
+    dsc.font = &lv_font_unscii_8;
+    dsc.align = LV_TEXT_ALIGN_LEFT;
+    dsc.text = text;
+    /* LVGL keeps a pointer in the queued draw task; copy it now so the caller
+     * can safely reuse its formatting buffer. */
+    dsc.text_local = 1;
+
+    lv_area_t area = {x, y, x + PVIEW_W - 1, y + 9};
+    lv_draw_label(layer, &dsc, &area);
+}
+
+/* Write the logo straight into the portrait buffer. Tall images would
+ * otherwise queue hundreds of LVGL draw tasks and can starve the renderer. */
+static void __attribute__((unused)) strata_draw_logo(void) {
+    /* Centred between the LINK text (ends at y=9) and the battery shell (y=101). */
+    const int y0 = 25;
+
+    for (int y = 0; y < 64; y++) {
+        uint32_t bits = strata_logo[y];
+        for (int x = 0; x < 32; x++) {
+            if (bits & (1u << (31 - x))) {
+                portrait_buf[(y0 + y) * PSTRIDE + x] = 0; /* STRATA_FG in L8 */
+            }
+        }
+    }
+}
+
+static void strata_redraw(void) {
+    if (portrait_canvas == NULL || panel_canvas == NULL) {
+        return;
+    }
+
+    lv_canvas_fill_bg(portrait_canvas, STRATA_BG, LV_OPA_COVER);
+
+    lv_layer_t layer;
+    lv_canvas_init_layer(portrait_canvas, &layer);
+
+    char buf[16];
+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
+    /* Output / link, drawn by whichever widget exists on this half. */
+    if (state.output[0] != '\0') {
+        strata_draw_text(&layer, 1, 1, state.output);
+    } else {
+        strata_draw_text(&layer, 1, 1, state.link ? "LINK" : "----");
+    }
+    if (state.connected || state.link) {
+        strata_fill(&layer, 3, 11, 26, 3, STRATA_FG);
+    } else {
+        strata_outline(&layer, 3, 11, 26, 3);
+    }
+
+    /* Five Bluetooth profile squares: active filled, rest outlined. */
+    for (int i = 0; i < 5; i++) {
+        if (i == state.profile) {
+            strata_fill(&layer, 3 + i * 5, 17, 4, 4, STRATA_FG);
+        } else {
+            strata_outline(&layer, 3 + i * 5, 17, 4, 4);
+        }
+    }
+    if (state.profile >= 0) {
+        snprintf(buf, sizeof(buf), "P%d", state.profile + 1);
+        strata_draw_text(&layer, 1, 24, buf);
+    }
+
+    /* Five layer squares, identical in shape to the Bluetooth profile squares. */
+    int count = ZMK_KEYMAP_LAYERS_LEN;
+    if (count > 5) {
+        count = 5;
+    }
+    for (int i = 0; i < 5; i++) {
+        if (i < count && i == state.layer_index) {
+            strata_fill(&layer, 3 + i * 5, 36, 4, 4, STRATA_FG);
+        } else {
+            strata_outline(&layer, 3 + i * 5, 36, 4, 4);
+        }
+    }
+    if (count > 0) {
+        snprintf(buf, sizeof(buf), "L%d", state.layer_index);
+        strata_draw_text(&layer, 1, 42, buf);
+    }
+    if (state.layer_label[0] != '\0') {
+        strata_draw_text(&layer, 1, 51, state.layer_label);
+    }
+#else
+    /* Peripheral: only the split link and the logo. */
+    strata_draw_text(&layer, 1, 1, state.link ? "LINK" : "----");
+    if (state.link) {
+        strata_fill(&layer, 3, 11, 26, 3, STRATA_FG);
+    } else {
+        strata_outline(&layer, 3, 11, 26, 3);
+    }
+    strata_draw_logo();
+#endif
+
+    /* Battery gauge. The nub (positive pole) is at +x, so the level must run
+     * along x too: the filled part stays at the far end and recedes toward the
+     * nub as charge drops, instead of shrinking across the side of the shell. */
+    int level = (state.battery * 23) / 100;
+    if (level < 1 && state.battery > 0) {
+        level = 1;
+    }
+    if (level > 23) {
+        level = 23;
+    }
+    strata_outline_rounded(&layer, 3, 101, 25, 13, 3);
+    strata_fill(&layer, 28, 104, 3, 6, STRATA_FG);
+    if (level > 0) {
+        strata_fill_rounded(&layer, 4, 102, level, 11, 2, STRATA_FG);
+    }
+    if (state.charging) {
+        /* Cut the bolt out of the filled bar when there is enough charge to
+         * cover it, otherwise draw it dark on the empty part. */
+        lv_color_t bolt_color = level >= 14 ? STRATA_BG : STRATA_FG;
+        strata_draw_bolt(&layer, 13, 104, bolt_color);
+    }
+
+    snprintf(buf, sizeof(buf), "%u%%", state.battery);
+    strata_draw_text(&layer, 1, 116, buf);
+
+    lv_canvas_finish_layer(portrait_canvas, &layer);
+
+    /* Rotate 90 degrees clockwise into the panel buffer. */
+    const uint8_t *src = lv_canvas_get_draw_buf(portrait_canvas)->data;
+    uint8_t *dst = lv_canvas_get_draw_buf(panel_canvas)->data;
+    for (int y = 0; y < PVIEW_H; y++) {
+        for (int x = 0; x < PVIEW_W; x++) {
+            dst[x * DSTRIDE + (PVIEW_H - 1 - y)] = src[y * PSTRIDE + x];
+        }
+    }
+
+    lv_obj_invalidate(panel_canvas);
+}
+
+void strata_ui_create(lv_obj_t *screen) {
+    portrait_canvas = lv_canvas_create(screen);
+    lv_obj_add_flag(portrait_canvas, LV_OBJ_FLAG_HIDDEN);
+    lv_canvas_set_buffer(portrait_canvas, portrait_buf, PVIEW_W, PVIEW_H, LV_COLOR_FORMAT_L8);
+
+    panel_canvas = lv_canvas_create(screen);
+    lv_obj_align(panel_canvas, LV_ALIGN_TOP_LEFT, 0, 0);
+    lv_canvas_set_buffer(panel_canvas, panel_buf, PANEL_W, PANEL_H, LV_COLOR_FORMAT_L8);
+
+    strata_redraw();
+}
+
+void strata_ui_set_output(const char *text, bool connected, int profile, bool bonded) {
+    ARG_UNUSED(bonded);
+
+    strncpy(state.output, text, sizeof(state.output) - 1);
+    state.output[sizeof(state.output) - 1] = '\0';
+    state.connected = connected;
+    state.profile = profile;
+    strata_redraw();
+}
+
+void strata_ui_set_battery(uint8_t level, bool charging) {
+    state.battery = level;
+    state.charging = charging;
+    strata_redraw();
+}
+
+void strata_ui_set_layer(int index, const char *label) {
+    state.layer_index = index;
+    if (label != NULL) {
+        strncpy(state.layer_label, label, sizeof(state.layer_label) - 1);
+        state.layer_label[sizeof(state.layer_label) - 1] = '\0';
+    } else {
+        state.layer_label[0] = '\0';
+    }
+    strata_redraw();
+}
+
+void strata_ui_set_link(bool connected) {
+    state.link = connected;
+    strata_redraw();
+}
+
 #if IS_ENABLED(CONFIG_ZMK_WIDGET_BATTERY_STATUS)
 static struct zmk_widget_battery_status battery_status_widget;
 #endif
@@ -35,35 +318,35 @@ static struct zmk_widget_wpm_status wpm_status_widget;
 #endif
 
 lv_obj_t *zmk_display_status_screen() {
-    lv_obj_t *screen;
-    screen = lv_obj_create(NULL);
+    lv_obj_t *screen = lv_obj_create(NULL);
+
+    /* Stock widget labels are hidden; their listeners only feed strata state. */
+    strata_ui_create(screen);
 
 #if IS_ENABLED(CONFIG_ZMK_WIDGET_BATTERY_STATUS)
     zmk_widget_battery_status_init(&battery_status_widget, screen);
-    lv_obj_align(zmk_widget_battery_status_obj(&battery_status_widget), LV_ALIGN_TOP_RIGHT, 0, 0);
+    lv_obj_add_flag(zmk_widget_battery_status_obj(&battery_status_widget), LV_OBJ_FLAG_HIDDEN);
 #endif
 
 #if IS_ENABLED(CONFIG_ZMK_WIDGET_OUTPUT_STATUS)
     zmk_widget_output_status_init(&output_status_widget, screen);
-    lv_obj_align(zmk_widget_output_status_obj(&output_status_widget), LV_ALIGN_TOP_LEFT, 0, 0);
+    lv_obj_add_flag(zmk_widget_output_status_obj(&output_status_widget), LV_OBJ_FLAG_HIDDEN);
 #endif
 
 #if IS_ENABLED(CONFIG_ZMK_WIDGET_PERIPHERAL_STATUS)
     zmk_widget_peripheral_status_init(&peripheral_status_widget, screen);
-    lv_obj_align(zmk_widget_peripheral_status_obj(&peripheral_status_widget), LV_ALIGN_TOP_LEFT, 0,
-                 0);
+    lv_obj_add_flag(zmk_widget_peripheral_status_obj(&peripheral_status_widget), LV_OBJ_FLAG_HIDDEN);
 #endif
 
 #if IS_ENABLED(CONFIG_ZMK_WIDGET_LAYER_STATUS)
     zmk_widget_layer_status_init(&layer_status_widget, screen);
-    lv_obj_set_style_text_font(zmk_widget_layer_status_obj(&layer_status_widget),
-                               lv_theme_get_font_small(screen), LV_PART_MAIN);
-    lv_obj_align(zmk_widget_layer_status_obj(&layer_status_widget), LV_ALIGN_BOTTOM_LEFT, 0, 0);
+    lv_obj_add_flag(zmk_widget_layer_status_obj(&layer_status_widget), LV_OBJ_FLAG_HIDDEN);
 #endif
 
 #if IS_ENABLED(CONFIG_ZMK_WIDGET_WPM_STATUS)
     zmk_widget_wpm_status_init(&wpm_status_widget, screen);
-    lv_obj_align(zmk_widget_wpm_status_obj(&wpm_status_widget), LV_ALIGN_BOTTOM_RIGHT, 0, 0);
+    lv_obj_add_flag(zmk_widget_wpm_status_obj(&wpm_status_widget), LV_OBJ_FLAG_HIDDEN);
 #endif
+
     return screen;
 }
diff --git a/app/src/display/strata_ui.h b/app/src/display/strata_ui.h
